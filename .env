# Environment variables for Flask application

# Flask application settings
FLASK_APP=plane_war_server:create_app  # Flask app factory in package
FLASK_ENV=development                   # Set to 'production' when deploying
PYTHONPATH=src                          # Allow importing package from ./src for CLI

# Secret key for Flask sessions and security features.
# IMPORTANT: Use a long, random, and unpredictable string.
# You can generate one using: python -c 'import secrets; print(secrets.token_hex(24))'
SECRET_KEY='garkEv-wocgor-wahko5'

# Database URL (SQLAlchemy connection string)
# Choose ONE of the following (or leave commented out to use the default SQLite in server/database.db)

# Default SQLite: if DATABASE_URL is unset, config.py uses a local file inside the package
# DATABASE_URL=sqlite:///database.db

# PostgreSQL Example:
# DATABASE_URL=postgresql://user:password@host:port/dbname

# MySQL Example (requires mysqlclient driver):
# DATABASE_URL=mysql+mysqlclient://user:password@host:port/dbname


