# Flask application settings
FLASK_APP=plane_war_server:create_app
FLASK_ENV=development
PYTHONPATH=src

# Secret key for Flask sessions and security features
# Generate a random value in production:
# python -c 'import secrets; print(secrets.token_hex(24))'
SECRET_KEY=change-me-in-prod

# Database URL (SQLAlchemy connection string)
# Leave unset to use the default SQLite file inside the package directory
# Examples:
# DATABASE_URL=sqlite:///database.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/planewar
# DATABASE_URL=mysql+mysqlclient://user:pass@localhost:3306/planewar
